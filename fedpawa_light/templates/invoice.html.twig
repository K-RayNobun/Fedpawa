<html>
<head>
    <style>
        body { font-family: Helvetica, Arial, sans-serif; color: #333; line-height: 1.5; margin: 40px; }
        h1 { color: #7A1C1C; font-size: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; font-size: 12px; }
        th { background-color: #f8f9fa; color: #333; }
        .total { text-align: right; font-size: 14px; font-weight: bold; margin-top: 20px; }
    </style>
</head>
<body>
    <h1>FACTURE / REÇU DE PAIEMENT</h1>
    <p><strong>Facture N° :</strong> {{ invoice_number|default('FAC-2026-001') }}</p>
    <p><strong>Date :</strong> {{ "now"|date("d/m/Y") }}</p>
    <p><strong>Client :</strong> {{ client_name }}</p>
    <table>
        <thead>
            <tr><th>Désignation</th><th>Montant (FCFA)</th></tr>
        </thead>
        <tbody>
            <tr><td>Prestation & Services FEDPAWA Corporate Solutions</td><td>{{ amount|default(50000)|number_format(0, ',', ' ') }}</td></tr>
        </tbody>
    </table>
    <div class="total">Total Payé : {{ amount|default(50000)|number_format(0, ',', ' ') }} FCFA</div>
</body>
</html>
